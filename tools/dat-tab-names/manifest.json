{
  "manifest_version": 3,
  "name": "Dispatch Up – Dispatcher Tools",
  "version": "1.11.1",
  "description": "Herramientas de Dispatch Up para despachadores: driver por pestaña, rating del broker, mercado del destino y email al broker.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://voice.google.com/*",
    "https://stc-debtor-service.rtspro.com/*",
    "https://tejzatzzwivvaznxyqej.supabase.co/*",
    "https://www.dispatch-up.com/*"
  ],
  "action": {
    "default_title": "DAT Driver Tabs — Configurar email y clave",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://one.dat.com/*"
      ],
      "js": [
        "content.js",
        "rts-chip.js",
        "market-chip.js",
        "email-template.js",
        "broker-email.js",
        "update-banner.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://one.dat.com/*"
      ],
      "js": [
        "dat-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://rtspro.com/*"
      ],
      "js": [
        "rts-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://rtspro.com/*"
      ],
      "js": [
        "rts-session.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://iq.prod.dat.com/*"
      ],
      "js": [
        "iq-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://iq.prod.dat.com/*"
      ],
      "js": [
        "iq-session.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
