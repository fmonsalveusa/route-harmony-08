{
  "manifest_version": 3,
  "name": "DAT Driver Tabs (Dispatch Up)",
  "version": "1.10.1",
  "description": "Ponle el nombre del driver a cada pestaña de búsqueda de DAT One, llama a los brokers con Google Voice, ve el rating de RTS de cada broker, el mercado de la ciudad destino y escríbeles por email con tu plantilla.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://voice.google.com/*",
    "https://stc-debtor-service.rtspro.com/*",
    "https://tejzatzzwivvaznxyqej.supabase.co/*",
    "https://www.dispatch-up.com/*"
  ],
  "action": {
    "default_title": "DAT Driver Tabs — Configurar email y clave"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://one.dat.com/*"
      ],
      "js": [
        "content.js",
        "rts-chip.js",
        "market-chip.js",
        "email-template.js",
        "broker-email.js",
        "update-banner.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://one.dat.com/*"
      ],
      "js": [
        "dat-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://rtspro.com/*"
      ],
      "js": [
        "rts-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://rtspro.com/*"
      ],
      "js": [
        "rts-session.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://iq.prod.dat.com/*"
      ],
      "js": [
        "iq-capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://iq.prod.dat.com/*"
      ],
      "js": [
        "iq-session.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "key": ""
}
